{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "skipLibCheck": true,
    "paths": {
      "react-native-iap": ["./node_modules/react-native-iap/lib/typescript/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "index.js", "__tests__/**/*.ts"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios"]
}
